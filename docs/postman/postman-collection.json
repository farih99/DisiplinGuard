            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": {{student_id}},\n  \"follow_up\": \"Melakukan pemantauan awal dan menjadwalkan tindak lanjut.\",\n  \"notes\": \"Dibuat melalui Postman untuk pengujian integrasi.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test(\"Riwayat memiliki ID dan student_id\", function () {",
                  "  pm.expect(body).to.have.property(\"data\");",
                  "  pm.expect(body.data).to.have.property(\"id\");",
