{
  "info": {
    "_postman_id": "8f0e2500-c36d-4d1e-9548-123456789abc",
    "name": "DisiplinGuard API - QA Collection",
    "description": "Postman Collection untuk API DisiplinGuard FastAPI. Import postman-environment.json terlebih dahulu. Jalankan request secara berurutan dari folder 1. Auth. Signup membuat email unik, login menyimpan token, refresh melakukan rotasi token dan memperbarui environment. Data siswa/kelas harus tersedia dan pengguna harus memiliki penugasan kelas yang sesuai. Endpoint AI saat scaffold belum memiliki model sehingga fallback 503 adalah expected. Folder Negative Cases memuat request yang sengaja mengharapkan 401, 403, 404, 422, dan 503. Request 403 membutuhkan ID siswa nyata di luar scope pengguna.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "description": "Signup, login, refresh token, dan profil pengguna.",
      "item": [
        {
          "name": "Daftarkan akun (Signup) - 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/signup"
            },
            "description": "Signup sesuai schema saat ini: email, password, dan role guru_bk/wali_kelas. Ganti test_password di environment sebelum dipakai.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{signup_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"role\": \"guru_bk\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Buat email unik untuk menghindari konflik saat collection dijalankan berulang.",
                  "pm.environment.set('signup_email', 'qa.' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test(\"Response memuat profil pengguna\", function () {",
                  "  pm.expect(body).to.have.property(\"id\");",
                  "  pm.expect(body).to.have.property(\"email\");",
                  "  pm.expect(body).to.have.property(\"role\");",
                  "});",
                  "if (body.id !== undefined) pm.environment.set(\"created_user_id\", String(body.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login pengguna (Login) - 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login"
            },
            "description": "Menyimpan access_token dan refresh_token secara otomatis ke environment.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{signup_email}}\",\n  \"password\": \"{{test_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test(\"Token access dan refresh tersedia\", function () {",
                  "  pm.expect(body.access_token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(body.refresh_token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(body.token_type).to.eql(\"bearer\");",
                  "});",
                  "if (body.access_token) pm.environment.set(\"access_token\", body.access_token);",
                  "if (body.refresh_token) pm.environment.set(\"refresh_token\", body.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Perbarui token (Refresh Token) - 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/refresh"
            },
            "description": "Refresh token dirotasi. Token refresh sebelumnya seharusnya tidak dapat digunakan kembali. Jalankan sebelum request protected berikutnya.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test(\"Token baru tersedia setelah rotasi\", function () {",
                  "  pm.expect(body.access_token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(body.refresh_token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "if (body.access_token) pm.environment.set(\"access_token\", body.access_token);",
                  "if (body.refresh_token) pm.environment.set(\"refresh_token\", body.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Profil pengguna aktif (Me) - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me"
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test(\"Profil berisi email dan role tanpa password hash\", function () {",
                  "  pm.expect(body).to.have.property(\"email\");",
                  "  pm.expect(body).to.have.property(\"role\");",
                  "  pm.expect(body).not.to.have.property(\"password_hash\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Students",
      "description": "Daftar dan detail data siswa, absensi, serta prestasi akademik.",
      "item": [
        {
          "name": "Daftar siswa (List Students) - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/students?page=1&limit=20"
            },
            "description": "Pengguna harus memiliki assignment kelas/jurusan yang sesuai agar siswa muncul pada daftar.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test(\"Response data berupa array\", function () { pm.expect(body.data).to.be.an(\"array\"); });",
                  "if (body.data && body.data.length > 0) {",
                  "  pm.environment.set(\"student_id\", String(body.data[0].id));",
                  "  pm.environment.set(\"student_code\", String(body.data[0].student_code || \"\"));",
                  "} else {",
                  "  console.warn(\"Daftar siswa kosong. Isi student_id secara manual atau periksa penugasan kelas pengguna.\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Detail siswa (Student Detail) - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/students/{{student_id}}"
            },
            "description": "student_id otomatis diisi dari request daftar siswa jika data tersedia.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test(\"Data siswa memiliki identitas dasar\", function () {",
                  "  pm.expect(body).to.have.property(\"data\");",
                  "  pm.expect(body.data).to.have.property(\"id\");",
                  "  pm.expect(body.data).to.have.property(\"student_code\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Absensi siswa (Student Attendance) - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/students/{{student_id}}/attendance"
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test(\"Nilai kehadiran berada di rentang 0-100\", function () {",
                  "  pm.expect(body.attendance_percentage).to.be.at.least(0);",
                  "  pm.expect(body.attendance_percentage).to.be.at.most(100);",
                  "  pm.expect(body.alpha_count).to.be.at.least(0);",
                  "  pm.expect(body.late_count).to.be.at.least(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Prestasi akademik siswa (Student Academic) - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/students/{{student_id}}/academic"
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test(\"Response memuat student_id dan average_score\", function () {",
                  "  pm.expect(body).to.have.property(\"student_id\");",
                  "  pm.expect(body).to.have.property(\"average_score\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Predictions",
      "description": "Endpoint AI prediksi dan pengambilan hasil prediksi.",
      "item": [
        {
          "name": "Buat prediksi kedisiplinan (Create Prediction) - 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/predictions"
            },
            "description": "Happy path ini baru akan lulus ketika model AI tersedia dan berhasil. Pada scaffold sekarang AIInferenceService memang mengembalikan 503 AI_UNAVAILABLE.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": {{student_id}},\n  \"attendance_percentage\": 92.5,\n  \"alpha_count\": 2,\n  \"late_count\": 3,\n  \"average_score\": 84.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test(\"Prediksi memuat kategori, skor, dan rekomendasi\", function () {",
                  "  pm.expect(body).to.have.property(\"data\");",
                  "  pm.expect([\"tinggi\", \"sedang\", \"rendah\"]).to.include(body.data.discipline_category);",
                  "  pm.expect(body.data).to.have.property(\"risk_score\");",
                  "  pm.expect(body.data.recommendation).to.be.a(\"string\");",
                  "});",
                  "if (body.data && body.data.id !== undefined) pm.environment.set(\"prediction_id\", String(body.data.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detail hasil prediksi (Get Prediction) - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/predictions/{{prediction_id}}"
            },
            "description": "Perlu prediction_id dari hasil prediksi sukses atau isi ID yang sudah tersimpan di database.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test(\"Detail memiliki identitas prediksi\", function () {",
                  "  pm.expect(body).to.have.property(\"data\");",
                  "  pm.expect(body.data).to.have.property(\"id\");",
                  "  pm.expect(body.data).to.have.property(\"student_id\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
