        {
          "name": "422 - Input prediksi tidak valid (Validation Error)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/predictions"
            },
            "description": "attendance_percentage=101 sengaja melanggar skema rentang 0-100; request seharusnya ditolak sebelum AI dipanggil.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": {{student_id}},\n  \"attendance_percentage\": 101,\n  \"alpha_count\": 2,\n  \"late_count\": 3,\n  \"average_score\": 84.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 422\", function () {",
                  "  pm.response.to.have.status(422);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test(\"Response menyediakan detail validasi\", function () { pm.expect(body).to.have.property(\"detail\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "503 - AI tidak tersedia (AI Unavailable / Timeout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/predictions"
            },
            "description": "Dengan scaffold saat ini, model belum tersedia sehingga hasil yang diharapkan adalah 503 AI_UNAVAILABLE. Student_id tetap harus dapat diakses pengguna.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": {{student_id}},\n  \"attendance_percentage\": 92.5,\n  \"alpha_count\": 2,\n  \"late_count\": 3,\n  \"average_score\": 84.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 503\", function () {",
                  "  pm.response.to.have.status(503);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test(\"Kode fallback sesuai kontrak\", function () {",
                  "  var code = body && body.detail && body.detail.code;",
                  "  pm.expect([\"AI_UNAVAILABLE\", \"AI_TIMEOUT\"]).to.include(code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
